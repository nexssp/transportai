@description "Refund request review with a human approval gate"
@profile refund_policy :timeout=3s :concurrency=16
@pipeline refund_review :profile=refund_policy :a2a_approval="billing.refund|refund|Refund request received. A manager must reply approve or reject before the request can proceed."
  @schema RefundRequest {
    TicketID    string `json:"ticket_id" validate:"required"`
    CustomerID  string `json:"customer_id" validate:"required"`
    AmountCents int    `json:"amount_cents" validate:"required"`
    Reason      string `json:"reason" validate:"required"`
  }
  schema.validate @{ name: "RefundRequest" } ->
  assert(.ticket_id != "", "ticket_id is required") ->
  assert(.customer_id != "", "customer_id is required") ->
  assert(.reason != "", "reason is required") ->
  assert(.amount_cents >= 1, "amount_cents must be positive") ->
  assert(.amount_cents <= 100000, "refund request exceeds the $1,000 review limit") ->
  {
    ticket_id: .ticket_id,
    customer_id: .customer_id,
    amount_cents: .amount_cents,
    reason: .reason,
    disposition: "approved_for_manual_processing",
    next_step: "A staff member must issue the refund in the billing system."
  }
@end

# Mount Flow pipelines with A2A bindings, then serve HTTP until shutdown.
ta2a.listen
